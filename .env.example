# Which ENS deployment to resolve against: mainnet | sepolia
CHAIN=sepolia
# One or more RPC URLs (comma-separated). Requests are spread across them with fallback.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional extra RPCs for resolving eip155 NFT avatars on other chains, as CHAIN_RPC_<chainId>
# CHAIN_RPC_1=https://ethereum-rpc.publicnode.com
# CHAIN_RPC_8453=https://base-rpc.publicnode.com

PORT=3000
# Redis cache. Without it the service uses a small in-process cache.
# REDIS_URL=redis://localhost:6379
PROFILE_CACHE_TTL=600
NOT_FOUND_CACHE_TTL=300

MAX_BULK_SIZE=10
IPFS_GATEWAY=https://ipfs.io/ipfs/
ARWEAVE_GATEWAY=https://arweave.net/
# Max concurrent CCIP-read requests per gateway host (offchain resolvers rate-limit bursts)
CCIP_CONCURRENCY_PER_HOST=6
# Check that the name's ETH address owns an eip155 NFT avatar (ENSIP-12)
AVATAR_VERIFY_NFT_OWNER=true
# Optional overrides (comma-separated)
# PROFILE_RECORDS=avatar,header,description,...
# MULTICOIN_CHAINS=0,60,2147492101
